PORT=3000
MONGO_URI=mongodb://localhost:27017/Gursha
JWT_SECRET=replace-with-strong-secret
FRONTEND_BASE_URL=http://localhost:5173

# Email provider selection: auto | resend | smtp
# Railway recommendation: set to resend (or leave as auto if RESEND keys exist).
EMAIL_PROVIDER=auto

# Resend (API-based, recommended on Railway)
RESEND_API_KEY=
RESEND_FROM=Gursha <noreply@your-domain.com>

# SMTP (fallback or local use)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000

# Optional comma-separated list for CORS, e.g. https://app.com,https://admin.app.com
CORS_ORIGINS=
